    { "name": "3. Evaluate", "type": "debugpy", "request": "launch",
      "module": "waf.evaluate" },
    { "name": "4. Demo app (WAF-protected)", "type": "debugpy", "request": "launch",
      "module": "uvicorn", "args": ["demo_app:app", "--reload", "--port", "8000"] }
  ]
