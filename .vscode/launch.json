{
  "version": "0.2.0",
  "configurations": [
    { "name": "1. Generate dataset", "type": "debugpy", "request": "launch",
      "module": "waf.generate_dataset", "args": ["--n", "12000"] },
    { "name": "2. Train", "type": "debugpy", "request": "launch",
